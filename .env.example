# Never commit real credentials or clinical text.
# Used only by the local synthetic smoke command; never configured as a Worker secret.
HEART_SMOKE_OPENROUTER_API_KEY=

OPENROUTER_MODEL=openai/gpt-5.6-sol
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

HEART_ENVIRONMENT=development
HEART_ALLOW_LIVE_LLM=false
HEART_MAX_INPUT_CHARS=20000
HEART_LLM_TIMEOUT_MS=120000
HEART_LLM_MAX_RETRIES=1
HEART_MAX_OUTPUT_TOKENS=16384
